# Production Caddyfile for Yearnit (VPS Self-Hosting Fallback)
# Provides: Automatic HTTPS, HTTP/3, zstd/gzip compression, and production security headers

{$DOMAIN:localhost} {
    # Automatic TLS using Let's Encrypt / ZeroSSL
    encode zstd gzip

    # Production Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        -Server
    }

    # Immutable Caching for Vite fingerprinted assets
    @static {
        path /assets/*
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Reverse proxy API requests to Node backend
    handle /api/* {
        reverse_proxy app:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Serve static frontend single-page application
    handle {
        root * /srv/dist
        try_files {path} /index.html
        file_server
    }
}
