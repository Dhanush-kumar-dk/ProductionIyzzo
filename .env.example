# ==============================================================================
# Yearnit / ProductionIyzzo Environment Variables Configuration
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control!
# ==============================================================================

# Core Application & Hosting
NODE_ENV=development
PORT=3000
VITE_API_BASE_URL=https://yearnit.in

# Supabase PostgreSQL Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Admin Operations Security (Protects /api/sendorderdata and /api/syncjoins)
ADMIN_API_KEY=your_secure_admin_api_token_here

# Distributed Serverless Rate Limiting & Caching (Optional Upstash Redis)
# If left blank, serverless functions use an in-memory sliding window bucket
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Cloudflare R2 Storage (Bucket for Screenshots & Product Images)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=yearnit-storage
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Firebase Authentication & Firestore Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id

# Amazon Associates & Affiliate Configuration
VITE_DEFAULT_PARTNER_TAG=dk29112306-21
VITE_BASE_PARTNER_TAG=dk29112306-21
VITE_AMAZON_CLIENT_ID=your_amazon_client_id
VITE_AMAZON_CLIENT_SECRET=your_amazon_client_secret

# Growth, Analytics & Tracking IDs
VITE_META_PIXEL_ID=1459486569390454
VITE_GA4_ID=G-G1F7RP0MFZ
VITE_GTM_ID=GTM-53M6FK9L
VITE_CLARITY_PROJECT_ID=pxz32p7t3q
