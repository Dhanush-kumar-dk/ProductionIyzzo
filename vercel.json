{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "rewrites": [
    {
      "source": "/product/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?i)(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|pinterest|skypeuripreview|applebot|redditbot|google|bingbot|viber|linespider|bot|crawler|spider).*"
        }
      ],
      "destination": "/api/og?id=:id"
    },
    {
      "source": "/product/:id/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?i)(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|pinterest|skypeuripreview|applebot|redditbot|google|bingbot|viber|linespider|bot|crawler|spider).*"
        }
      ],
      "destination": "/api/og?id=:id"
    },
    {
      "source": "/p/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?i)(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|pinterest|skypeuripreview|applebot|redditbot|google|bingbot|viber|linespider|bot|crawler|spider).*"
        }
      ],
      "destination": "/api/og?id=:id"
    },
    {
      "source": "/sendorderdata",
      "destination": "/api/sendorderdata"
    },
    {
      "source": "/getorders",
      "destination": "/api/getorders"
    },
    {
      "source": "/syncjoins",
      "destination": "/api/syncjoins"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}