{
  "rewrites": [
    {
      "source": "/sendorderdata",
      "destination": "/api/sendorderdata"
    },
    {
      "source": "/getorders",
      "destination": "/api/getorders"
    },
    {
      "source": "/syncjoins",
      "destination": "/api/syncjoins"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
